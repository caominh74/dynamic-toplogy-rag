# Model used by the agent. Any LiteLLM model string works.
# For a generic OpenAI-compatible server, prefix the model with openai/:
# TOPO_RAG_MODEL=openai/deepseek-flash
TOPO_RAG_MODEL=openai/deepseek-flash

# Cloud credentials (only set the one you use)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Optional: enable semantic vector search.
# Without this, vector_search falls back to BM25.
# TOPO_RAG_EMBEDDING_MODEL=text-embedding-3-small
# TOPO_RAG_EMBEDDING_MODEL=ollama/nomic-embed-text

# Optional: custom OpenAI-compatible or native Ollama endpoint.
# OpenAI-compatible servers usually expose the API under /v1:
# TOPO_RAG_API_BASE=http://localhost:8000/v1
# Native Ollama (use a model like ollama/qwen2.5:7b):
# TOPO_RAG_API_BASE=http://localhost:11434
